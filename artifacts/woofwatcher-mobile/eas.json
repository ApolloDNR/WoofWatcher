{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BUILD_PROFILE": "development"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BUILD_PROFILE": "internal"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "candidate": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_STORE_PUSH_TOKEN_REGISTRATION": "disabled",
        "EXPO_PUBLIC_STORE_CLOUD_DOCUMENT_UPLOAD": "disabled"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_STORE_PUSH_TOKEN_REGISTRATION": "disabled",
        "EXPO_PUBLIC_STORE_CLOUD_DOCUMENT_UPLOAD": "disabled"
      },
      "ios": {},
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {}
    }
  }
}
